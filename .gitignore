# ===========================
# PlacementPro – .gitignore
# ===========================

# --- Environment / Secrets (NEVER commit) ---
.env
.env.local
.env.development
.env.test
*.env
!.env.example
!.env.production.example

# --- Node.js / Frontend ---
node_modules/
frontend/node_modules/
backend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity

# --- React build output ---
frontend/build/
build/

# --- Java / Maven ---
backend-springboot/target/
*.class
*.jar
*.war
*.ear
*.nar
!**/src/main/**/*.jar
hs_err_pid*
.mvn/wrapper/maven-wrapper.jar

# --- IDE / Editor ---
.idea/
*.iml
*.iws
.vscode/
.eclipse/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# --- Logs ---
logs/
*.log
*.log.*

# --- OS ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Temporary ---
*.tmp
*.temp
*.bak
*.swp
*.orig
.cache/
frontend/.cache/

# --- Test coverage ---
coverage/
.nyc_output/

# --- Sensitive / credentials ---
*.pem
*.p12
*.key
*.keystore
*.jks
secrets.json
credentials.json
serviceAccountKey.json
